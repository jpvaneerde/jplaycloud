<?xml version="1.0" encoding="UTF-8"?>
<!-- JPlay for Samsung TVs (Tizen). A small launcher that opens go.jplay.cloud in TV mode:
     the game itself comes from the server, so updates never need a reinstall. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://jplay.cloud/tv" version="1.0.0" viewmodes="maximized">
    <tizen:application id="JPlayTVapp.JPlay" package="JPlayTVapp" required_version="3.0"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <icon src="icon.png"/>
    <name>JPlay</name>
    <description>The music year game on your TV: the QR-code version of JPlay, played with the remote.</description>
    <author href="https://jplay.cloud">JPlay</author>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>jplay.cloud *.jplay.cloud</tizen:allow-navigation>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
