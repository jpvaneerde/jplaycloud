{
  "name": "jplay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "PORT=8787 DATA_DIR=./data ADMIN_EMAIL=${ADMIN_EMAIL:-admin@example.com} node --watch --experimental-strip-types --disable-warning=ExperimentalWarning server/index.ts",
    "build": "vite build",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/index.ts",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.server.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.20.5",
    "svelte": "^5.28.1",
    "svelte-check": "^4.1.6",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.13",
    "jose": "^6.2.12"
  }
}
